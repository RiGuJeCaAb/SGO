{
  "name": "sgo-estacao-pea",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Ferramentas de desenvolvimento da Estação PEA. A aplicação entregue não depende de nada disto.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verificar": "node ferramentas/verificar.mjs",
    "testar": "node --test tests/*.test.mjs",
    "lint": "node ferramentas/lint.mjs",
    "tudo": "npm run verificar && npm run testar && npm run lint && npm run tipos && npm run morto && npm run documentar && npm run manual",
    "visual": "node ferramentas/visual.mjs",
    "tipos": "node ferramentas/tipos.mjs",
    "montar": "node ferramentas/montar.mjs",
    "validar-gp": "node ferramentas/validar-gestaopco.mjs",
    "morto": "node ferramentas/morto.mjs",
    "documentar": "node ferramentas/documentar.mjs",
    "manual": "node ferramentas/manual.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2"
  }
}
